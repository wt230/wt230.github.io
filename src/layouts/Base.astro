---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import fs from "node:fs";
import yaml from "js-yaml";

const site = yaml.load(fs.readFileSync("./src/data/site.yml", "utf8"));

const { title, description = site.thesis } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const analytics = site.analytics ?? {};
const counterUrl = analytics.goatcounter
  ? `https://${analytics.goatcounter}.goatcounter.com/count`
  : null;

const nav = [
  { href: "/research", label: "Research" },
  { href: "/people", label: "People" },
  { href: "/publications", label: "Publications" },
  { href: "/facilities", label: "Facilities" },
  { href: "/join", label: "Join us" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title ? `${title} — ${site.group_name}` : `${site.group_name} — ${site.tagline}`}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="wrap masthead__inner">
        <a class="wordmark" href="/">
          <span class="wordmark__name">{site.group_name}</span>
          <span class="wordmark__unit">{site.institution}</span>
        </a>
        <nav aria-label="Main">
          <ul class="plain navlist">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={pathname === item.href ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__inner">
        <div>
          <p class="footer__name">{site.group_name}</p>
          <p class="footer__addr">
            {site.contact.office}<br />
            <span set:html={site.contact.address.replace(/\n/g, "<br />")} />
          </p>
        </div>
        <div>
          <p>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a><br />
            <span class="data">{site.contact.phone}</span>
          </p>
          <p class="footer__note">{site.funding_note}</p>
        </div>
      </div>
    </footer>

    <style>
      .masthead {
        border-bottom: 1px solid var(--rule);
        background: var(--paper);
        position: sticky;
        top: 0;
        z-index: 20;
      }

      .masthead__inner {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 2rem;
        align-items: baseline;
        justify-content: space-between;
        padding-block: 1.05rem;
      }

      .wordmark {
        text-decoration: none;
        display: block;
      }

      .wordmark__name {
        display: block;
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.22rem;
        letter-spacing: -0.02em;
        font-variation-settings: "wdth" 88;
      }

      .wordmark__unit {
        display: block;
        font-family: var(--data);
        font-size: 0.68rem;
        letter-spacing: 0.07em;
        color: var(--ink-45);
        margin-top: 0.15rem;
      }

      .navlist {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 1.6rem;
        font-family: var(--display);
        font-size: 0.96rem;
        font-weight: 500;
      }

      .navlist a {
        text-decoration: none;
        padding-bottom: 2px;
        border-bottom: 2px solid transparent;
      }

      .navlist a:hover {
        border-bottom-color: var(--mb-300);
      }

      .navlist a[aria-current="page"] {
        border-bottom-color: var(--mb-700);
      }

      .footer {
        border-top: 1px solid var(--rule);
        background: var(--paper-sunk);
        margin-top: var(--stack);
        padding-block: 3rem 3.5rem;
        font-size: 0.94rem;
      }

      .footer__inner {
        display: grid;
        gap: 2rem 4rem;
        grid-template-columns: 1fr;
      }

      @media (min-width: 46rem) {
        .footer__inner {
          grid-template-columns: 1fr 1fr;
        }
      }

      .footer__name {
        font-family: var(--display);
        font-weight: 700;
        margin-bottom: 0.4rem;
      }

      .footer__addr,
      .footer__note {
        color: var(--ink-70);
        line-height: 1.5;
      }

      .footer__note {
        font-size: 0.86rem;
        max-width: 42ch;
      }
    </style>
    {
      counterUrl ? (
        <script
          is:inline
          defer
          data-goatcounter={counterUrl}
          data-goatcounter-settings={JSON.stringify({
            no_onload: false,
            allow_local: false,
          })}
          src="//gc.zgo.at/count.js"
        />
      ) : null
    }
    {
      counterUrl && analytics.respect_dnt ? (
        <script is:inline>
          {/* Skip counting anyone asking not to be tracked. */}
          if (navigator.doNotTrack === "1" || navigator.globalPrivacyControl) {
            window.goatcounter = { no_onload: true };
          }
        </script>
      ) : null
    }
  </body>
</html>
