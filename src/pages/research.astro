---
import fs from "node:fs";
import yaml from "js-yaml";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import AopCalculator from "../components/AopCalculator.jsx";
import PubEntry from "../components/PubEntry.astro";
import ReactorFigure from "../components/ReactorFigure.astro";
import { byPrimaryTheme, THEMES } from "../lib/bib.js";

const site = yaml.load(fs.readFileSync("./src/data/site.yml", "utf8"));
const isTodo = (v) => typeof v === "string" && v.trim().toUpperCase().startsWith("TODO");

const themePhotos = import.meta.glob(
  "../assets/research/*.{jpg,jpeg,png,webp}", { eager: true }
);
function themePhoto(name) {
  if (!name) return null;
  const hit = Object.entries(themePhotos).find(
    ([path]) => path.split("/").pop().replace(/\.\w+$/, "") === name
  );
  return hit ? hit[1].default : null;
}
---

<Base title="Research" description="Research on micropollutant treatment, radical scavenging capacity, water quality monitoring, and UV photochemistry.">
  <section class="pagehead">
    <div class="wrap">
      <h1>Research</h1>
    </div>
  </section>

  <section class="figure-band">
    <div class="figure-band__wrap">
      <ReactorFigure />
    </div>
  </section>

  {
    site.themes.map((theme) => {
      const pubs = byPrimaryTheme(theme.slug).slice(0, 4);
      return (
        <section class="section" id={theme.slug}>
          <div class="wrap split">
            <div>
              <hr class="decay-rule" />
              <h2>{theme.title}</h2>
              <p class="theme__tag data">{THEMES[theme.slug]}</p>
            </div>
            <div>
              {themePhoto(theme.photo) ? (
                <figure class="theme__photo">
                  <Image
                    src={themePhoto(theme.photo)}
                    alt={theme.photo_caption ?? theme.title}
                    widths={[600, 900, 1400]}
                    sizes="(min-width: 56rem) 44rem, 94vw"
                    loading="lazy"
                  />
                  {theme.photo_caption ? (
                    <figcaption>{theme.photo_caption}</figcaption>
                  ) : null}
                </figure>
              ) : null}
              <p class="theme__blurb">{theme.blurb}</p>
              {!isTodo(theme.detail) && theme.detail ? <p>{theme.detail}</p> : null}
              {theme.link ? (
                <p class="theme__link">
                  <a href={theme.link}>{theme.link_label ?? "Read more"} →</a>
                </p>
              ) : null}
              {pubs.length ? (
                <div class="theme__pubs">
                  <span class="label">Selected papers</span>
                  <ul class="plain">
                    {pubs.map((pub) => <PubEntry pub={pub} />)}
                  </ul>
                </div>
              ) : null}
            </div>
          </div>
        </section>
      );
    })
  }
  <section class="section section--sunk" id="calculator">
    <div class="wrap">
      <hr class="decay-rule" />
      <h2>Try the UV/H₂O₂ model</h2>
      <p class="calc__intro">
        The kinetics our work rests on, in a form you can push around. Change
        the water, the peroxide dose or the compound, and see how far the
        micropollutant actually degrades — and how much of that is the radical
        rather than the light.
      </p>
    </div>
    <div class="calc__wrap">
      <AopCalculator client:visible />
    </div>
  </section>

</Base>

<style>
  .pagehead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.25rem);
  }
  .figure-band {
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  /* Wider than the standard .wrap so the two 3D panels get real room. */
  .figure-band__wrap {
    max-width: 100rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
  }
  .theme__tag {
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-45);
  }
  .theme__photo {
    margin: 0 0 1.5rem;
  }
  .theme__photo :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }
  .theme__photo figcaption {
    font-family: var(--data);
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--ink-45);
    margin-top: 0.6rem;
  }
  .theme__blurb {
    font-size: 1.1rem;
    line-height: 1.55;
  }
  .theme__link {
    font-family: var(--data);
    font-size: 0.82rem;
    margin-top: 1.1rem;
  }
  .theme__link a {
    text-decoration: none;
    border-bottom: 1px solid var(--mb-300);
  }
  .theme__pubs {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .calc__intro {
    max-width: var(--measure);
    margin-bottom: 1.75rem;
  }
  .calc__wrap {
    max-width: 100rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
  }
</style>
