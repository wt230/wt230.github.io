---
import fs from "node:fs";
import yaml from "js-yaml";
import Base from "../layouts/Base.astro";
import PubEntry from "../components/PubEntry.astro";
import ReactorFigure from "../components/ReactorFigure.astro";
import { byTheme, THEMES } from "../lib/bib.js";

const site = yaml.load(fs.readFileSync("./src/data/site.yml", "utf8"));
const isTodo = (v) => typeof v === "string" && v.trim().toUpperCase().startsWith("TODO");
---

<Base title="Research">
  <section class="pagehead">
    <div class="wrap">
      <h1>Research</h1>
    </div>
  </section>

  <section class="figure-band">
    <div class="wrap">
      <ReactorFigure />
    </div>
  </section>

  {
    site.themes.map((theme) => {
      const pubs = byTheme(theme.slug).slice(0, 4);
      return (
        <section class="section" id={theme.slug}>
          <div class="wrap split">
            <div>
              <hr class="decay-rule" />
              <h2>{theme.title}</h2>
              <p class="theme__tag data">{THEMES[theme.slug]}</p>
            </div>
            <div>
              <p class="theme__blurb">{theme.blurb}</p>
              {!isTodo(theme.detail) && theme.detail ? <p>{theme.detail}</p> : null}
              {theme.link ? (
                <p class="theme__link">
                  <a href={theme.link}>{theme.link_label ?? "Read more"} →</a>
                </p>
              ) : null}
              {pubs.length ? (
                <div class="theme__pubs">
                  <span class="label">Selected papers</span>
                  <ul class="plain">
                    {pubs.map((pub) => <PubEntry pub={pub} />)}
                  </ul>
                </div>
              ) : null}
            </div>
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  .pagehead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.25rem);
  }
  .figure-band {
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .theme__tag {
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-45);
  }
  .theme__blurb {
    font-size: 1.1rem;
    line-height: 1.55;
  }
  .theme__link {
    font-family: var(--data);
    font-size: 0.82rem;
    margin-top: 1.1rem;
  }
  .theme__link a {
    text-decoration: none;
    border-bottom: 1px solid var(--mb-300);
  }
  .theme__pubs {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
</style>
