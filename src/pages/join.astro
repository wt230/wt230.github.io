---
import fs from "node:fs";
import yaml from "js-yaml";
import Base from "../layouts/Base.astro";
import { pi, counts } from "../lib/people.js";

const site = yaml.load(fs.readFileSync("./src/data/site.yml", "utf8"));
const isTodo = (v) =>
  typeof v === "string" && v.trim().toUpperCase().startsWith("TODO");
const { openings } = site;
// The "useful background" note sits above the first entry-level position,
// since it describes preparation an undergraduate will not have yet.
const bgIndex = (openings.positions ?? []).findIndex((r) => r.entry_level);
---

<Base
  title="Join us"
  description="Funded graduate positions in water treatment and water chemistry at the University of Manitoba."
>
  <section class="pagehead">
    <div class="wrap">
      <span class="label">Join us</span>
      <h1>{openings.open ? "Join the group" : "Openings"}</h1>
      <p class="lede">
        We take graduate students, postdoctoral researchers and undergraduate
        researchers. This page says what is available, what we look for, and
        what to put in a first email.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>Open positions</h2>
      </div>
      <div>
        {
          openings.open ? (
            <ul class="plain roles">
              {openings.positions.map((role, i) => (
                <>
                {i === bgIndex ? (
                  <li class="roles__bg">
                    <strong>Useful background:</strong> {openings.background}
                  </li>
                ) : null}
                <li>
                  <h3>{role.level}</h3>
                  {role.topic ? <p class="roles__topic">{role.topic}</p> : null}
                  {role.funded ? (
                    <p class="roles__meta data">
                      Funded position
                      {!isTodo(role.start) && role.start ? ` · Starting ${role.start}` : ""}
                    </p>
                  ) : null}
                  {role.detail ? <p class="roles__detail">{role.detail}</p> : null}
                </li>
                </>
              ))}
            </ul>
          ) : (
            <p>
              No positions are open at the moment. This page is kept current,
              so if nothing is listed here, nothing is available.
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>What to put in a first email</h2>
      </div>
      <div>
        <p>
          A short, specific email gets a real reply. Include:
        </p>
        <ol class="asks">
          {openings.email_expectations.map((item) => <li>{item}</li>)}
        </ol>
        <p class="asks__addr">
          Send it to <a href={`mailto:${pi.email}`}>{pi.email}</a>.
        </p>
        <p class="asks__note">
          Graduate applicants also need to meet the admission requirements of
          the UM Faculty of Graduate Studies. These include an English
          language proficiency requirement, which applies to certain
          international applicants. Emailing first is worth doing before you
          pay an application fee.
        </p>
      </div>
    </div>
  </section>

</Base>

<style>
  .pagehead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }
  .roles li {
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .roles li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .roles h3 {
    margin-bottom: 0.2rem;
  }
  .roles__topic {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }
  .roles__meta {
    font-size: 0.76rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--mb-700);
    margin: 0;
  }
  .roles__detail {
    margin: 0.6rem 0 0;
    font-size: 0.96rem;
    color: var(--ink-70);
    max-width: 52ch;
  }
  .roles__bg {
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.96rem;
    color: var(--ink-70);
    max-width: 56ch;
  }
  .asks {
    counter-reset: ask;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    max-width: var(--measure);
  }
  .asks li {
    counter-increment: ask;
    position: relative;
    padding-left: 2.4rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--rule);
  }
  .asks li::before {
    content: counter(ask);
    position: absolute;
    left: 0;
    top: 0.85rem;
    font-family: var(--data);
    font-size: 0.78rem;
    color: var(--mb-500);
  }
  .asks__addr {
    font-size: 1.05rem;
  }
  .asks__note {
    font-size: 0.9rem;
    color: var(--ink-45);
  }
</style>
