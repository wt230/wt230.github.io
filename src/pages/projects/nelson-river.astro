---
import fs from "node:fs";
import yaml from "js-yaml";
import Base from "../../layouts/Base.astro";
import PubEntry from "../../components/PubEntry.astro";
import { allWorks } from "../../lib/bib.js";

const site = yaml.load(fs.readFileSync("./src/data/site.yml", "utf8"));
const project = yaml.load(
  fs.readFileSync("./src/data/nelson-river.yml", "utf8")
);

const isTodo = (v) =>
  typeof v === "string" && v.trim().toUpperCase().startsWith("TODO");
const real = (v) => (isTodo(v) || !v ? null : v);

const facts = (project.facts ?? []).filter((f) => real(f.value));
// An update is only shown once it has both a date and a headline.
const updates = (project.updates ?? []).filter(
  (u) => real(u.date) && real(u.title)
);
// Explicit keys, not a theme query: the monitoring tag also carries work
// that belongs elsewhere on the site but not on this project page.
const keys = project.publications ?? [];
const pubs = keys
  .map((k) => allWorks.find((w) => w.key === k))
  .filter(Boolean);
---

<Base title={project.title} description={project.summary}>
  <section class="pagehead">
    <div class="wrap">
      <span class="label">Project</span>
      <h1>{project.title}</h1>
      <p class="lede">{project.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>What we are doing</h2>
      </div>
      <div>
        <p class="summary">{project.summary}</p>
        {
          project.aims?.length ? (
            <ul class="aims">
              {project.aims.map((aim) => <li>{aim}</li>)}
            </ul>
          ) : null
        }
      </div>
    </div>
  </section>

  {
    facts.length ? (
      <section class="section section--sunk">
        <div class="wrap split">
          <div>
            <hr class="decay-rule" />
            <h2>The project</h2>
          </div>
          <div>
            <dl class="facts">
              {facts.map((f) => (
                <>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </>
              ))}
            </dl>
          </div>
        </div>
      </section>
    ) : null
  }

  <section class="section">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>Updates</h2>
      </div>
      <div>
        {
          updates.length ? (
            <ol class="plain log">
              {updates.map((u) => (
                <li>
                  <p class="log__date data">{u.date}</p>
                  <h3>{u.title}</h3>
                  {real(u.body) ? <p>{u.body}</p> : null}
                </li>
              ))}
            </ol>
          ) : (
            <p class="pending">
              Field work is under way and updates will be posted here as the
              project progresses.
            </p>
          )
        }
      </div>
    </div>
  </section>

  {
    pubs.length ? (
      <section class="section section--sunk">
        <div class="wrap split">
          <div>
            <hr class="decay-rule" />
            <h2>Related publications</h2>
          </div>
          <div>
            <ul class="plain">
              {pubs.map((pub) => <PubEntry pub={pub} />)}
            </ul>
          </div>
        </div>
      </section>
    ) : null
  }

  <section class="section">
    <div class="wrap">
      <p class="contact">
        {project.contact_note}{" "}
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .pagehead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }
  .summary {
    font-size: 1.08rem;
    line-height: 1.6;
  }
  .aims {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    max-width: var(--measure);
  }
  .aims li {
    position: relative;
    padding: 0.55rem 0 0.55rem 1.4rem;
    border-top: 1px solid var(--rule);
    font-size: 0.96rem;
    color: var(--ink-70);
  }
  .aims li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mb-300);
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 0;
  }
  @media (min-width: 34rem) {
    .facts {
      grid-template-columns: 10rem 1fr;
      column-gap: 1.5rem;
    }
  }
  .facts dt {
    font-family: var(--data);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-45);
    padding-top: 0.85rem;
    border-top: 1px solid var(--rule);
  }
  .facts dd {
    margin: 0;
    padding: 0.85rem 0;
    font-size: 0.96rem;
    color: var(--ink-70);
  }
  @media (min-width: 34rem) {
    .facts dd {
      border-top: 1px solid var(--rule);
    }
  }
  .log li {
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .log li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .log__date {
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mb-500);
    margin: 0 0 0.3rem;
  }
  .log h3 {
    margin-bottom: 0.4rem;
  }
  .pending,
  .contact {
    color: var(--ink-70);
  }
</style>
