---
import Base from "../../layouts/Base.astro";
import AopCalculator from "../../components/AopCalculator.jsx";
---

<Base
  title="UV/H₂O₂ AOP calculator"
  description="An interactive model of micropollutant degradation by UV/H2O2, combining hydroxyl radical oxidation and direct 254 nm photolysis."
>
  <section class="pagehead">
    <div class="wrap">
      <span class="label">Tool</span>
      <h1>UV/H₂O₂ AOP calculator</h1>
      <p class="lede">
        How far does a micropollutant degrade under UV/H₂O₂, and how much of
        that is the radical rather than the light? Change the water, the dose
        and the compound, and watch the answer move.
      </p>
    </div>
  </section>

  <section class="tool">
    <div class="tool__wrap">
      <AopCalculator client:visible />
    </div>
  </section>
</Base>

<style>
  .pagehead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.25rem);
  }
  .tool {
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .tool__wrap {
    max-width: 100rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
  }
</style>
