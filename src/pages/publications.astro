---
import Base from "../layouts/Base.astro";
import PubEntry from "../components/PubEntry.astro";
import { publications, byYear } from "../lib/bib.js";

const years = byYear();
---

<Base title="Publications">
  <section class="pagehead">
    <div class="wrap">
      <span class="label">Publications</span>
      <h1>Publications</h1>
      <p class="lede">Listed newest first.</p>
    </div>
  </section>

  {
    years.map(([year, pubs]) => (
      <section class="section">
        <div class="wrap split">
          <div>
            <hr class="decay-rule" />
            <h2 class="yr">{year}</h2>
          </div>
          <div>
            <ul class="plain">
              {pubs.map((pub) => <PubEntry pub={pub} />)}
            </ul>
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .pagehead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }
  .yr {
    font-variant-numeric: tabular-nums;
  }
  .section {
    padding-block: clamp(2rem, 4vw, 3rem);
  }
</style>
