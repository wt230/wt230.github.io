---
import Base from "../layouts/Base.astro";
import PubEntry from "../components/PubEntry.astro";
import { allWorks } from "../lib/bib.js";
---

<Base title="Publications">
  <section class="pagehead">
    <div class="wrap">
      <span class="label">Publications</span>
      <h1>Publications</h1>
      <p class="lede">Newest first. Patents are marked.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ul class="plain list">
        {allWorks.map((work) => <PubEntry pub={work} />)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .pagehead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }
  .list {
    max-width: 58rem;
  }
</style>
