---
import Base from "../layouts/Base.astro";
import PubEntry from "../components/PubEntry.astro";
import { publications, patents, byYear } from "../lib/bib.js";

const years = byYear();
---

<Base title="Publications">
  <section class="pagehead">
    <div class="wrap">
      <span class="label">Publications</span>
      <h1>Publications</h1>
      <p class="lede">Listed newest first.</p>
    </div>
  </section>

  {
    patents.length ? (
      <section class="section">
        <div class="wrap split">
          <div>
            <hr class="decay-rule" />
            <h2>Patents</h2>
          </div>
          <div>
            <ul class="plain">
              {patents.map((pt) => (
                <li class="patent">
                  <p class="patent__authors">
                    {pt.authors.map((a, i) => (
                      <>
                        <span class={a.startsWith("Wang, C") ? "patent__self" : ""}>
                          {a}
                        </span>{i < pt.authors.length - 1 ? "; " : ""}
                      </>
                    ))}
                  </p>
                  <h3 class="patent__title">{pt.title}</h3>
                  <p class="patent__meta data">
                    {pt.number}
                    <span class="patent__year"> · {pt.year}</span>
                    {pt.note ? <span class="patent__tag">{pt.note}</span> : null}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ) : null
  }

  {
    years.map(([year, pubs]) => (
      <section class="section">
        <div class="wrap split">
          <div>
            <hr class="decay-rule" />
            <h2 class="yr">{year}</h2>
          </div>
          <div>
            <ul class="plain">
              {pubs.map((pub) => <PubEntry pub={pub} />)}
            </ul>
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .pagehead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }
  .yr {
    font-variant-numeric: tabular-nums;
  }
  .section {
    padding-block: clamp(2rem, 4vw, 3rem);
  }
  .patent {
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .patent:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .patent__authors {
    font-family: var(--data);
    font-size: 0.78rem;
    color: var(--ink-45);
    margin: 0 0 0.45rem;
    max-width: none;
  }
  .patent__self {
    color: var(--ink);
    font-weight: 500;
  }
  .patent__title {
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.45rem;
    max-width: 58ch;
  }
  .patent__meta {
    font-size: 0.8rem;
    color: var(--ink-70);
    margin: 0;
    max-width: none;
  }
  .patent__year {
    color: var(--ink-45);
  }
  .patent__tag {
    display: inline-block;
    margin-left: 0.6rem;
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--mb-700);
    border: 1px solid var(--mb-300);
    border-radius: 2px;
    padding: 0.1rem 0.4rem;
  }
</style>
