---
import fs from "node:fs";
import yaml from "js-yaml";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";

const site = yaml.load(fs.readFileSync("./src/data/site.yml", "utf8"));
const isTodo = (v) =>
  typeof v === "string" && v.trim().toUpperCase().startsWith("TODO");

/**
 * Photos live in src/assets/facilities/. Importing them through the
 * glob (rather than putting them in public/) lets Astro resize and
 * convert them to webp at build time, so a phone photo dropped in here
 * doesn't ship as a 4 MB download.
 */
const photos = import.meta.glob(
  "../assets/facilities/*.{jpg,jpeg,png,webp,avif}",
  { eager: true }
);

function photoFor(filename) {
  if (!filename) return null;
  const hit = Object.entries(photos).find(([path]) =>
    path.endsWith(`/${filename}`)
  );
  return hit ? hit[1].default : null;
}
---

<Base title="Facilities" description="Instrumentation in the Wang Group lab and the shared Environmental Engineering Laboratory.">
  <section class="pagehead">
    <div class="wrap">
      <span class="label">Facilities</span>
      <h1>What is in the lab</h1>
      <p class="lede">
        Experimental, computational, and field capability built since 2021.
      </p>
    </div>
  </section>

  {
    site.banner && photoFor(site.banner.photo) ? (
      <figure class="banner">
        <Image
          src={photoFor(site.banner.photo)}
          alt={site.banner.caption}
          widths={[900, 1456, 2000]}
          sizes="(min-width: 76rem) 72rem, 94vw"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>{site.banner.caption}</figcaption>
      </figure>
    ) : null
  }

  <section class="section">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>Instrumentation</h2>
      </div>
      <div>
        <ul class="plain kit">
          {
            site.facilities.map((f) => {
              const img = photoFor(f.photo);
              return (
                <li>
                  <h3>{f.name}</h3>
                  {f.short ? <p class="kit__short data">{f.short}</p> : null}
                  {!isTodo(f.detail) ? <p>{f.detail}</p> : null}
                  {img ? (
                    <figure
                      class="kit__figure"
                      style={f.photo_width ? `--fig-w:${f.photo_width}%` : undefined}
                    >
                      <Image
                        src={img}
                        alt={f.caption ?? f.name}
                        widths={[600, 900, 1400]}
                        sizes="(min-width: 56rem) 46rem, 92vw"
                        loading="lazy"
                      />
                      {f.caption ? <figcaption>{f.caption}</figcaption> : null}
                    </figure>
                  ) : null}
                </li>
              );
            })
          }
        </ul>
        {
          site.facilities_note ? (
            <p class="kit__note">{site.facilities_note}</p>
          ) : null
        }
        <p class="fund">{site.funding_note}</p>
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap">
      <hr class="decay-rule" />
      <h2>Departmental facilities</h2>

      {
        photoFor(site.shared_facilities.photo) ? (
          <figure class="banner banner--flush">
            <Image
              src={photoFor(site.shared_facilities.photo)}
              alt={site.shared_facilities.caption}
              widths={[900, 1400, 2200]}
              sizes="(min-width: 76rem) 68rem, 94vw"
              loading="lazy"
            />
            <figcaption>{site.shared_facilities.caption}</figcaption>
          </figure>
        ) : null
      }

      <p class="shared__intro">{site.shared_facilities.paragraph}</p>
    </div>
  </section>
</Base>

<style>
  .pagehead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.25rem);
  }
  /* Constrained to the text column, not full-bleed. */
  .banner {
    margin: 0 auto clamp(1.5rem, 4vw, 3rem);
    max-width: 76rem;
    padding-inline: var(--gutter);
  }
  /* No crop: the point of the photograph is the whole bench, from the
     solvent bottles across to the monitor. */
  .banner :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }
  /* Already inside a .wrap, so it must not add its own gutters. */
  .banner--flush {
    max-width: none;
    padding-inline: 0;
    margin: 1.75rem 0;
  }
  .shared__intro {
    max-width: var(--measure);
  }
  .banner figcaption {
    font-family: var(--data);
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--ink-45);
    padding-top: 0.75rem;
    max-width: 60ch;
  }
  .kit li {
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }
  .kit h3 {
    margin-bottom: 0.2rem;
  }
  .kit__short {
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-45);
    margin: 0 0 0.9rem;
  }
  .kit p {
    color: var(--ink-70);
    font-size: 0.98rem;
    margin: 0;
  }
  .kit__figure {
    margin: 1.1rem 0 0;
    width: var(--fig-w, 100%);
  }
  .kit__figure :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper-sunk);
  }
  .kit__figure figcaption {
    font-family: var(--data);
    font-size: 0.74rem;
    line-height: 1.55;
    color: var(--ink-45);
    margin-top: 0.65rem;
    max-width: 48ch;
  }
  .shared {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    max-width: var(--measure);
  }
  .shared li {
    padding: 0.6rem 0 0.6rem 1.4rem;
    border-top: 1px solid var(--rule);
    font-size: 0.96rem;
    color: var(--ink-70);
    position: relative;
  }
  .shared li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mb-300);
  }
  .kit__note {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.94rem;
    color: var(--ink-70);
  }
  .fund {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--data);
    font-size: 0.82rem;
    color: var(--ink-45);
    line-height: 1.6;
  }
</style>
