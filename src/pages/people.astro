---
import Base from "../layouts/Base.astro";
import PersonCard from "../components/PersonCard.astro";
import { pi, current, alumni, coSupervisors, real } from "../lib/people.js";

// The PI is the first entry in the roster rather than a separate block.
const roster = [{ ...pi, lead: true }, ...current];

// Alphabetical by surname, taking the last word of the name. Change to
// a.name.localeCompare(b.name) if you would rather sort by first name.
const surname = (n) => n.trim().split(/\s+/).slice(-1)[0];
const alumniSorted = [...alumni].sort((a, b) =>
  surname(a.name).localeCompare(surname(b.name), "en")
);
---

<Base title="People">
  <section class="pagehead">
    <div class="wrap">
      <span class="label">People</span>
      <h1>Who is here</h1>

    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>The group</h2>
      </div>
      <div>
        <ul class="plain">
          {roster.map((p) => <PersonCard person={p} lead={p.lead} />)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>Alumni</h2>
      </div>
      <div>
        <ul class="plain alumni">
          {alumniSorted.map((p) => <PersonCard person={p} alum={true} />)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>Co-supervision</h2>
      </div>
      <div>
        <p>
          Several students in the group are co-advised with colleagues
          elsewhere in the university, which means two supervisors, two
          research groups, and access to a wider set of methods than any
          one lab holds.
        </p>
        <ul class="plain cosup">
          {coSupervisors.map((c) => (
            <li>
              <strong>{c.title ?? "Prof."} {c.name}</strong>
              <span class="data"> · {c.unit}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .pagehead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }
  .alumni {
    columns: 2;
    column-gap: 3rem;
  }
  @media (max-width: 42rem) {
    .alumni {
      columns: 1;
    }
  }
  .alumni :global(.person) {
    break-inside: avoid;
  }
  .cosup li {
    padding-block: 0.6rem;
    border-top: 1px solid var(--rule);
    font-size: 0.96rem;
  }
  .cosup .data {
    font-size: 0.78rem;
    color: var(--ink-45);
  }
</style>
