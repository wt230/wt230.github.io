---
import fs from "node:fs";
import yaml from "js-yaml";
import Base from "../layouts/Base.astro";
import HeroSlides from "../components/HeroSlides.astro";
import PubEntry from "../components/PubEntry.astro";
import { publications } from "../lib/bib.js";
import { pi, current, real } from "../lib/people.js";

const site = yaml.load(fs.readFileSync("./src/data/site.yml", "utf8"));
const recent = publications.slice(0, 3);

// Preview of the roster for the home page; the full list lives on /people.
// The glob check matters: people.yml sets a photo path for everyone, but
// most of those files do not exist yet, and a bare path would render a
// broken image rather than falling back to initials.
const photoFiles = import.meta.glob(
  "/public/images/people/*.{jpg,jpeg,png,webp}",
  { eager: true }
);
const onDisk = (path) =>
  path && Object.keys(photoFiles).some((f) => f.endsWith(path)) ? path : null;

const preview = [pi, ...current].map((person) => ({
  name: person.short_name ?? person.name,
  role: person.role,
  photo: onDisk(real(person.photo)),
  initials: person.name
    .split(/\s+/)
    .filter((w) => /^[A-Z]/.test(w))
    .slice(0, 2)
    .map((w) => w[0])
    .join(""),
}));
---

<Base>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <span class="label">{site.institution}</span>
        <h1>{site.tagline}</h1>
        <p class="lede">{site.thesis}</p>
        <p class="hero__actions">
          <a class="cta" href="/join">Join the group</a>
          <a class="cta cta--quiet" href="/research">What we work on</a>
        </p>
      </div>
      <div class="hero__figure">
        <HeroSlides />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>Research</h2>
      </div>
      <div>
        <ul class="plain themes">
          {
            site.themes.map((theme) => (
              <li class="theme">
                <h3>
                  <a href={`/research#${theme.slug}`}>{theme.title}</a>
                </h3>
                <p>{theme.blurb}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>The group</h2>
      </div>
      <div>
        <ul class="plain roster">
          {
            preview.map((p) => (
              <li class="roster__person">
                <span class="roster__avatar">
                  {p.photo ? (
                    <img src={p.photo} alt="" width="176" height="176" loading="lazy" />
                  ) : (
                    <span aria-hidden="true">{p.initials}</span>
                  )}
                </span>
                <span class="roster__name">{p.name}</span>
                <span class="roster__role data">{p.role}</span>
              </li>
            ))
          }
        </ul>
        <p class="stats__note">
          Students in the group are co-advised across three departments at
          the University of Manitoba, and undergraduate researchers are
          funded through NSERC and Mitacs Globalink. See
          <a href="/people">everyone here</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>Recent work</h2>
        <p class="side-note">
          <a href="/publications">All publications →</a>
        </p>
      </div>
      <div>
        <ul class="plain">
          {recent.map((pub) => <PubEntry pub={pub} />)}
        </ul>
      </div>
    </div>
  </section>

  {
    site.openings.open && (
      <section class="section callout">
        <div class="wrap">
          <hr class="decay-rule" />
          <h2>We are looking for graduate students</h2>
          <p class="lede">
            Funded positions are available. Before you email, read the page —
            it says what we work on, what background helps, and what a first
            message should contain.
          </p>
          <p>
            <a class="cta" href="/join">What we are looking for</a>
          </p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3rem, 7vw, 5.5rem);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    grid-template-columns: 1fr;
  }

  /* One column: the text card and the figures below it both run the
     full width of the page. */
  .hero__text {
    max-width: none;
  }

  .hero__text .lede {
    max-width: 74ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .themes {
    display: grid;
    gap: 2.25rem;
  }

  @media (min-width: 48rem) {
    .themes {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 3rem;
    }
  }

  .theme h3 {
    margin-bottom: 0.5rem;
  }

  .theme h3 a {
    text-decoration: none;
    border-bottom: 2px solid var(--mb-100);
    padding-bottom: 1px;
  }

  .theme h3 a:hover {
    border-bottom-color: var(--mb-500);
  }

  .theme p {
    font-size: 0.98rem;
    color: var(--ink-70);
    margin: 0;
  }

  .roster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--avatar), 1fr));
    gap: 1.75rem 1.25rem;
    margin: 0 0 2rem;
  }

  .roster__person {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .roster__avatar {
    width: var(--avatar);
    height: var(--avatar);
    border-radius: 50%;
    overflow: hidden;
    background: var(--mb-100);
    color: var(--mb-700);
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.6rem;
    margin-bottom: 0.75rem;
  }

  .roster__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .roster__name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.25;
  }

  .roster__role {
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--ink-45);
    line-height: 1.35;
  }

  .stats__note {
    color: var(--ink-70);
    font-size: 0.98rem;
  }

  .side-note {
    font-family: var(--data);
    font-size: 0.8rem;
  }

  .side-note a {
    text-decoration: none;
    border-bottom: 1px solid var(--mb-300);
  }

  .callout .lede {
    max-width: 52ch;
  }
</style>
