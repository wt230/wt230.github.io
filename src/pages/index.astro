---
import fs from "node:fs";
import yaml from "js-yaml";
import Base from "../layouts/Base.astro";
import HeroSlides from "../components/HeroSlides.astro";
import PubEntry from "../components/PubEntry.astro";
import { publications } from "../lib/bib.js";
import { counts } from "../lib/people.js";

const site = yaml.load(fs.readFileSync("./src/data/site.yml", "utf8"));
const recent = publications.slice(0, 3);
---

<Base>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <span class="label">{site.institution}</span>
        <h1>{site.tagline}</h1>
        <p class="lede">{site.thesis}</p>
        <p class="hero__actions">
          <a class="cta" href="/join">Join the group</a>
          <a class="cta cta--quiet" href="/research">What we work on</a>
        </p>
      </div>
      <div class="hero__figure">
        <HeroSlides />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>Research</h2>
      </div>
      <div>
        <ul class="plain themes">
          {
            site.themes.map((theme) => (
              <li class="theme">
                <h3>
                  <a href={`/research#${theme.slug}`}>{theme.title}</a>
                </h3>
                <p>{theme.blurb}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>The group</h2>
      </div>
      <div>
        <dl class="stats">
          <div>
            <dt>People currently in the lab</dt>
            <dd class="data">{counts.current}</dd>
          </div>
          <div>
            <dt>Trainees who have come through</dt>
            <dd class="data">{counts.total}</dd>
          </div>
          <div>
            <dt>Peer-reviewed publications</dt>
            <dd class="data">{publications.length}</dd>
          </div>
        </dl>
        <p class="stats__note">
          Students in the group are co-advised across three departments at
          the University of Manitoba, and undergraduate researchers are
          funded through NSERC and Mitacs. See <a href="/people">who is here</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <hr class="decay-rule" />
        <h2>Recent work</h2>
        <p class="side-note">
          <a href="/publications">All {publications.length} publications →</a>
        </p>
      </div>
      <div>
        <ul class="plain">
          {recent.map((pub) => <PubEntry pub={pub} />)}
        </ul>
      </div>
    </div>
  </section>

  {
    site.openings.open && (
      <section class="section callout">
        <div class="wrap">
          <hr class="decay-rule" />
          <h2>We are looking for graduate students</h2>
          <p class="lede">
            Funded positions are available. Before you email, read the page —
            it says what we work on, what background helps, and what a first
            message should contain.
          </p>
          <p>
            <a class="cta" href="/join">What we are looking for</a>
          </p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3rem, 7vw, 5.5rem);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    grid-template-columns: 1fr;
  }

  /* One column: the text card and the figures below it both run the
     full width of the page. */
  .hero__text {
    max-width: none;
  }

  .hero__text .lede {
    max-width: 74ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .themes {
    display: grid;
    gap: 2.25rem;
  }

  @media (min-width: 48rem) {
    .themes {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 3rem;
    }
  }

  .theme h3 {
    margin-bottom: 0.5rem;
  }

  .theme h3 a {
    text-decoration: none;
    border-bottom: 2px solid var(--mb-100);
    padding-bottom: 1px;
  }

  .theme h3 a:hover {
    border-bottom-color: var(--mb-500);
  }

  .theme p {
    font-size: 0.98rem;
    color: var(--ink-70);
    margin: 0;
  }

  .stats {
    display: grid;
    gap: 1.75rem;
    margin: 0 0 2rem;
  }

  @media (min-width: 40rem) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stats dt {
    font-family: var(--data);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-45);
    line-height: 1.5;
    max-width: 18ch;
  }

  .stats dd {
    margin: 0.5rem 0 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--mb-700);
  }

  .stats__note {
    color: var(--ink-70);
    font-size: 0.98rem;
  }

  .side-note {
    font-family: var(--data);
    font-size: 0.8rem;
  }

  .side-note a {
    text-decoration: none;
    border-bottom: 1px solid var(--mb-300);
  }

  .callout .lede {
    max-width: 52ch;
  }
</style>
