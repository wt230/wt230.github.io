---
/**
 * The group's own measurement, drawn as the page's opening image.
 *
 * Methylene blue is the probe compound in the external calibration
 * method (Wang et al., ES&T 2020). Under UV/H2O2 the dye is consumed
 * by hydroxyl radicals and the solution loses its colour; the rate of
 * that loss is what the method converts into a scavenging capacity.
 * The cuvettes below follow A/A0 = exp(-kt), and the curve is drawn
 * through the same values.
 */

// A/A0 at each sampled exposure, pseudo-first-order, k = 0.42
const points = [
  { t: 0, a: 1.0, x: 88, y: 100 },
  { t: 1, a: 0.657, x: 188, y: 144.6 },
  { t: 2, a: 0.432, x: 288, y: 173.8 },
  { t: 3, a: 0.284, x: 388, y: 193.1 },
  { t: 4, a: 0.187, x: 488, y: 205.7 },
  { t: 5, a: 0.122, x: 588, y: 214.1 },
  { t: 6, a: 0.081, x: 688, y: 219.5 },
];

const curve = [
  "M88,100",
  "C121.3,100 154.7,144.6 188,144.6",
  "C221.3,144.6 254.7,173.8 288,173.8",
  "C321.3,173.8 354.7,193.1 388,193.1",
  "C421.3,193.1 454.7,205.7 488,205.7",
  "C521.3,205.7 554.7,214.1 588,214.1",
  "C621.3,214.1 654.7,219.5 688,219.5",
].join(" ");
---

<figure class="decay">
  <svg
    viewBox="0 72 760 228"
    role="img"
    aria-labelledby="decay-title decay-desc"
    preserveAspectRatio="xMidYMid meet"
  >
    <title id="decay-title">Methylene blue decay under UV and hydrogen peroxide</title>
    <desc id="decay-desc">
      Seven cuvettes shown left to right, fading from deep blue to nearly
      colourless, with an exponential decay curve drawn through the
      corresponding absorbance values.
    </desc>

    <!-- baseline -->
    <line x1="52" y1="248" x2="724" y2="248" stroke="var(--rule)" stroke-width="1"></line>

    <!-- cuvettes: the visible experiment -->
    {
      points.map((p, i) => (
        <g class="cuvette" style={`--i:${i}`}>
          <rect
            x={p.x - 21}
            y={252}
            width="42"
            height="30"
            rx="2"
            fill="var(--mb-700)"
            opacity={Math.max(p.a, 0.045)}
          />
        </g>
      ))
    }

    <!-- decay curve through the same values -->
    <path
      class="decay__curve"
      d={curve}
      fill="none"
      stroke="var(--mb-700)"
      stroke-width="2.5"
      stroke-linecap="round"
    ></path>

    {
      points.map((p, i) => (
        <circle
          class="decay__dot"
          style={`--i:${i}`}
          cx={p.x}
          cy={p.y}
          r="4.5"
          fill="var(--paper)"
          stroke="var(--mb-700)"
          stroke-width="2.5"
        />
      ))
    }

    <!-- axis annotations -->
    <text x="52" y="92" class="decay__axis">A / A₀</text>
    <text x="724" y="288" text-anchor="end" class="decay__axis">UV exposure →</text>
  </svg>

  <figcaption>
    Methylene blue consumed by hydroxyl radicals under UV/H<sub>2</sub>O<sub>2</sub>.
    The rate of colour loss is what our calibration method converts into a
    water's radical scavenging capacity.
  </figcaption>
</figure>

<style>
  .decay {
    margin: 0;
  }

  .decay svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .decay__axis {
    font-family: var(--data);
    font-size: 13px;
    fill: var(--ink-45);
    letter-spacing: 0.06em;
  }

  figcaption {
    font-family: var(--data);
    font-size: 0.76rem;
    line-height: 1.55;
    color: var(--ink-45);
    max-width: 44ch;
    margin-top: 1.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  /* Resting state is the finished figure. Motion is added only when
     the reader hasn't asked for less of it. */
  @media (prefers-reduced-motion: no-preference) {
    .decay__curve {
      stroke-dasharray: 900;
      stroke-dashoffset: 900;
      animation: draw 1.9s cubic-bezier(0.22, 0.61, 0.36, 1) 0.25s forwards;
    }

    .decay__dot,
    .cuvette {
      opacity: 0;
      animation: settle 0.5s ease-out forwards;
      animation-delay: calc(0.45s + var(--i) * 0.16s);
    }

    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }

    @keyframes settle {
      from {
        opacity: 0;
        transform: translateY(5px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
