---
/**
 * Three photo slides for the hero section.
 */
---

<div class="rig-outer">
  <div class="rig" data-rig>
    <figure class="rig__cell is-active">
      <img src="/images/hero-1.jpg" alt="Research team and equipment in the lab" />
      <figcaption>Research team and equipment in the lab</figcaption>
    </figure>

    <figure class="rig__cell">
      <img src="/images/hero-2.png" alt="Lab instrumentation and workflow" />
      <figcaption>Lab instrumentation and workflow</figcaption>
    </figure>

    <figure class="rig__cell">
      <img src="/images/hero-3.jpg" alt="Field and team work snapshot" />
      <figcaption>Field and team work snapshot</figcaption>
    </figure>
  </div>
</div>

<script>
  const rig = document.querySelector("[data-rig]");
  if (rig) {
    const cells = Array.from(rig.querySelectorAll(".rig__cell"));
    let index = 0;

    const show = (nextIndex) => {
      cells.forEach((cell, i) => {
        cell.classList.toggle("is-active", i === nextIndex);
      });
    };

    const cycle = () => {
      index = (index + 1) % cells.length;
      show(index);
    };

    show(index);

    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduced) {
      setInterval(cycle, 5000);
    }
  }
</script>

<style>
  .rig-outer {
    container-type: inline-size;
  }

  .rig {
    position: relative;
    display: grid;
    gap: clamp(1rem, 3vw, 2.5rem);
    grid-template-columns: 1fr;
  }

  .rig__cell {
    margin: 0;
    padding: 0;
    display: none;
    flex-direction: column;
    min-height: clamp(24rem, 44vh, 36rem);
    overflow: hidden;
    border-radius: 1rem;
    background: var(--ink-96);
    box-shadow: 0 12px 40px rgba(15, 23, 42, 0.08);
  }

  .rig__cell.is-active {
    display: flex;
  }

  .rig__cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    flex: 1 1 auto;
    min-height: 0;
  }

  .rig__cell figcaption {
    font-family: var(--data);
    font-size: 0.66rem;
    line-height: 1.45;
    color: var(--ink-45);
    padding: 0.9rem 1rem 1rem;
    border-top: 1px solid var(--rule);
  }
</style>
