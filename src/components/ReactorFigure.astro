---
/**
 * Sits at the top of the Research page.
 *
 * Left  : the annular LP-UV reactor, geometry and materials lifted from
 *         the group's parametric reactor model (cut-away view, 20 cm
 *         diameter, 34 cm chamber, 29.5 cm arc in a 6 cm quartz sleeve).
 *         The fluence-field shading and bubble cloud are left out here
 *         because they need the solver; everything structural is as-is.
 *
 * Right : C/C0 for atrazine at 500 mJ cm-2 with 10 mg/L H2O2, over
 *         background scavenging capacity and A254. Both spin; neither
 *         is interactive.
 */
---

<div class="rfig-outer">
  <div class="rfig" data-rfig>
  <figure class="rfig__cell">
    <canvas data-reactor aria-hidden="true"></canvas>
    <figcaption>Annular low-pressure UV reactor, shown in section</figcaption>
  </figure>

  <figure class="rfig__cell">
    <canvas data-surface aria-hidden="true"></canvas>
    <figcaption>
      Micropollutant remaining after UV/H₂O₂ treatment —
      <a class="fig__link" href="#calculator">play with it →</a>
    </figcaption>
  </figure>

  <p class="rfig__fallback" data-fallback hidden>
    An annular low-pressure UV reactor, and the surface describing how much
    micropollutant survives it as the water's radical scavenging capacity
    and UV absorbance change.
  </p>
  </div>
</div>

<script>
  import { model, COMPOUNDS } from "../lib/aop.js";

  const rig = document.querySelector("[data-rfig]");
  if (rig) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const PI = Math.PI;

    // reactor constants, as in the source model
    const SLEEVE_R = 3.0;
    const LAMP_ARC = 29.5;
    const LAMP_OAL = 35.7;
    const DIAMETER = 20;
    const HEIGHT = 34;
    const R = DIAMETER / 2;
    const gap = R - SLEEVE_R;

    function fail() {
      rig.querySelectorAll("canvas").forEach((c) => (c.hidden = true));
      rig.querySelector("[data-fallback]").hidden = false;
    }

    async function boot() {
      let THREE;
      try {
        THREE = await import("three");
      } catch {
        return fail();
      }

      /* ------------------------------------------------ shared helpers */

      function annulus(ri, ro, t, phiStart, phiLength) {
        const pts = [
          new THREE.Vector2(ri, 0), new THREE.Vector2(ro, 0),
          new THREE.Vector2(ro, t), new THREE.Vector2(ri, t),
          new THREE.Vector2(ri, 0),
        ];
        return new THREE.LatheGeometry(pts, 72, phiStart, phiLength);
      }

      function makeEnvTexture() {
        const cv = document.createElement("canvas");
        cv.width = 512; cv.height = 256;
        const ctx = cv.getContext("2d");
        const g = ctx.createLinearGradient(0, 0, 0, 256);
        g.addColorStop(0, "#5C6B78"); g.addColorStop(0.42, "#2A3542");
        g.addColorStop(0.52, "#151C24"); g.addColorStop(1, "#070A0E");
        ctx.fillStyle = g; ctx.fillRect(0, 0, 512, 256);
        ctx.fillStyle = "rgba(215,235,255,0.85)";
        ctx.fillRect(60, 26, 90, 60); ctx.fillRect(300, 34, 54, 46);
        const tex = new THREE.CanvasTexture(cv);
        tex.mapping = THREE.EquirectangularReflectionMapping;
        return tex;
      }

      /**
       * Text on a plane rather than a sprite. A sprite always faces the
       * camera flat-on, which is why the labels used to sit at odd angles
       * to the axes they belong to. A plane can be aligned with its axis
       * and flipped when the view would otherwise show it back-to-front.
       *
       * Returns { holder, plate } — set holder.position and holder.rotation.y
       * to place and aim it, and plate.rotation.z to flip the text.
       */
      function textPlate(text, color, px, height) {
        const SS = 4;
        const m = document.createElement("canvas").getContext("2d");
        const font = `700 ${px * SS}px ui-monospace, SFMono-Regular, Menlo, monospace`;
        m.font = font;
        const w = Math.ceil(m.measureText(text).width) + 8 * SS;
        const h = (px + 10) * SS;
        const cv = document.createElement("canvas");
        cv.width = w; cv.height = h;
        const ctx = cv.getContext("2d");
        ctx.font = font;
        ctx.fillStyle = color;
        ctx.textBaseline = "middle";
        ctx.textAlign = "center";
        ctx.fillText(text, w / 2, h / 2);

        const tex = new THREE.CanvasTexture(cv);
        tex.minFilter = THREE.LinearMipmapLinearFilter;
        tex.magFilter = THREE.LinearFilter;
        tex.generateMipmaps = true;
        tex.anisotropy = 4;

        const aspect = w / h;
        const plate = new THREE.Mesh(
          new THREE.PlaneGeometry(height * aspect, height),
          new THREE.MeshBasicMaterial({
            map: tex, transparent: true, side: THREE.DoubleSide,
            depthTest: false, depthWrite: false,
          })
        );
        plate.renderOrder = 40;
        const holder = new THREE.Group();
        holder.add(plate);
        return { holder, plate };
      }

      /**
       * Fit for an object spinning about Y. Width is set by its radius in
       * the xz plane (constant under that rotation) and height by the box,
       * checked against the horizontal and vertical fields of view
       * separately. A bounding sphere would over-pull on a tall thin
       * object like the reactor and leave it small in frame.
       */
      function fitMetrics(object) {
        const box = new THREE.Box3().setFromObject(object);
        let rxz = 0;
        object.traverse((n) => {
          const g = n.geometry;
          if (!g || !g.attributes || !g.attributes.position) return;
          g.computeBoundingBox();
          const bb = g.boundingBox;
          n.updateWorldMatrix(true, false);
          for (const cx of [bb.min.x, bb.max.x])
            for (const cy of [bb.min.y, bb.max.y])
              for (const cz of [bb.min.z, bb.max.z]) {
                const v = new THREE.Vector3(cx, cy, cz).applyMatrix4(n.matrixWorld);
                rxz = Math.max(rxz, Math.hypot(v.x, v.z));
              }
        });
        return {
          rxz,
          halfH: (box.max.y - box.min.y) / 2,
          centreY: (box.max.y + box.min.y) / 2,
        };
      }

      function fitDistance(camera, m, margin) {
        const vHalf = (camera.fov * Math.PI) / 180 / 2;
        const hHalf = Math.atan(Math.tan(vHalf) * camera.aspect);
        const need = Math.max(m.rxz / Math.tan(hHalf), m.halfH / Math.tan(vHalf));
        return need * margin + m.rxz;
      }

      function mount(canvas, fov, near, far) {
        const renderer = new THREE.WebGLRenderer({
          canvas, antialias: true, alpha: true,
        });
        renderer.setPixelRatio(Math.min(2, devicePixelRatio || 1));
        if ("outputEncoding" in renderer) renderer.outputEncoding = THREE.sRGBEncoding;
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(fov, 1, near, far);
        const resize = () => {
          const w = canvas.clientWidth || 1, h = canvas.clientHeight || 1;
          renderer.setSize(w, h, false);
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
        };
        new ResizeObserver(resize).observe(canvas);
        resize();
        return { renderer, scene, camera };
      }

      /* ------------------------------------------------------- reactor */

      function buildReactor(canvas) {
        const { renderer, scene, camera } = mount(canvas, 38, 0.5, 3000);
        const env = makeEnvTexture();

        scene.add(new THREE.HemisphereLight(0x9fc4dd, 0x0b1016, 0.55));
        const key = new THREE.DirectionalLight(0xffffff, 0.85);
        key.position.set(60, 90, 70);
        const rimL = new THREE.DirectionalLight(0x8fa8ff, 0.5);
        rimL.position.set(-80, 40, -60);
        const fl = new THREE.DirectionalLight(0xffe6c0, 0.25);
        fl.position.set(30, -40, 60);
        scene.add(key, rimL, fl);

        const grid = new THREE.GridHelper(110, 11, 0xb9c6d4, 0xdbe2ec);
        grid.material.transparent = true;
        grid.material.opacity = 0.75;
        grid.position.y = -6;
        scene.add(grid);

        const root = new THREE.Group();
        scene.add(root);

        const H = HEIGHT;
        const steel = new THREE.MeshStandardMaterial({ color: 0xc3ced7, metalness: 0.92, roughness: 0.26, envMap: env, side: THREE.DoubleSide });
        const steelDark = new THREE.MeshStandardMaterial({ color: 0x7d8b96, metalness: 0.85, roughness: 0.4, envMap: env });
        const ptfe = new THREE.MeshStandardMaterial({ color: 0xe8ebe6, metalness: 0.05, roughness: 0.65 });
        const glass = new THREE.MeshStandardMaterial({ color: 0xcfe8ff, metalness: 0.1, roughness: 0.05, envMap: env, transparent: true, opacity: 0.22, side: THREE.DoubleSide, depthWrite: false });
        const yellow = new THREE.MeshStandardMaterial({ color: 0xf2b705, metalness: 0.45, roughness: 0.42, envMap: env });
        const motorGreen = new THREE.MeshStandardMaterial({ color: 0x5f8f7a, metalness: 0.5, roughness: 0.45, envMap: env });

        const g = new THREE.Group();
        const ts = PI / 2;      // section view
        const tl = PI;
        const wall = 0.4;

        const shell = new THREE.Mesh(new THREE.CylinderGeometry(R, R, H, 128, 1, true, ts, tl), steel);
        shell.position.y = H / 2; g.add(shell);
        const rimTop = new THREE.Mesh(annulus(R - wall, R, wall, ts, tl), steelDark);
        rimTop.position.y = H; g.add(rimTop);
        const lid = new THREE.Mesh(annulus(SLEEVE_R + 0.3, R + 1.4, 1.0, ts, tl), steel);
        lid.position.y = H; g.add(lid);
        const collar = new THREE.Mesh(annulus(SLEEVE_R, SLEEVE_R + 2.6, 1.0, 0, PI * 2), ptfe);
        collar.position.y = H + 1.0; g.add(collar);

        const boltGeo = new THREE.CylinderGeometry(0.45, 0.45, 0.8, 8);
        for (let i = 0; i < 16; i++) {
          const ang = (i / 16) * PI * 2;
          if (ang < ts || ang > ts + tl) continue;
          const b = new THREE.Mesh(boltGeo, steelDark);
          b.position.set((R + 0.7) * Math.sin(ang), H + 1.4, (R + 0.7) * Math.cos(ang));
          g.add(b);
        }
        const base = new THREE.Mesh(annulus(4.3, R + 1.4, 1.2, ts, tl), steel);
        base.position.y = -1.2; g.add(base);
        const feet = new THREE.Mesh(annulus(R * 0.55, R * 0.72, 3.2, 0, PI * 2), steelDark);
        feet.position.y = -4.4; g.add(feet);

        // sparger ring and feed line
        const diffR = SLEEVE_R + gap * 0.5;
        const diffGroup = new THREE.Group();
        const torus = new THREE.Mesh(
          new THREE.TorusGeometry(diffR, 0.5, 10, 56, PI), steelDark
        );
        torus.rotation.x = PI / 2;
        diffGroup.add(torus);
        diffGroup.rotation.y = PI;
        diffGroup.position.y = 1.1;
        g.add(diffGroup);
        const feed = new THREE.Mesh(new THREE.CylinderGeometry(0.45, 0.45, 6.5, 14), steelDark);
        feed.position.set(0, -2.0, -diffR);
        g.add(feed);

        const sleeve = new THREE.Mesh(new THREE.CylinderGeometry(SLEEVE_R, SLEEVE_R, H + 8, 64, 1, true), glass);
        sleeve.position.y = H / 2 - 2; g.add(sleeve);

        const arcBottom = (H - LAMP_ARC) / 2;
        const arcCentre = H / 2;
        const tube = new THREE.Mesh(
          new THREE.CylinderGeometry(1.15, 1.15, LAMP_OAL, 40, 1, true),
          new THREE.MeshStandardMaterial({ color: 0xd8ecff, metalness: 0.1, roughness: 0.08, envMap: env, transparent: true, opacity: 0.35, side: THREE.DoubleSide, depthWrite: false })
        );
        tube.position.y = arcCentre;
        const arcMesh = new THREE.Mesh(
          new THREE.CylinderGeometry(0.92, 0.92, LAMP_ARC, 36),
          new THREE.MeshBasicMaterial({ color: 0xb6a8ff })
        );
        arcMesh.position.y = arcCentre;
        const glow = new THREE.Mesh(
          new THREE.CylinderGeometry(1.9, 1.9, LAMP_ARC, 36, 1, true),
          new THREE.MeshBasicMaterial({ color: 0x8f7bff, transparent: true, opacity: 0.34, side: THREE.DoubleSide, depthWrite: false })
        );
        glow.position.y = arcCentre;
        g.add(tube, arcMesh, glow);

        const capGeo = new THREE.CylinderGeometry(1.3, 1.3, 2.4, 20);
        const capA = new THREE.Mesh(capGeo, steelDark);
        capA.position.y = arcCentre + LAMP_OAL / 2 - 1.2;
        const capB = new THREE.Mesh(capGeo, steelDark);
        capB.position.y = arcCentre - LAMP_OAL / 2 + 1.2;
        g.add(capA, capB);
        for (let i = 0; i < 4; i++) {
          const ang = (i / 4) * PI * 2;
          const pin = new THREE.Mesh(new THREE.CylinderGeometry(0.11, 0.11, 1.6, 8), steelDark);
          pin.position.set(0.55 * Math.sin(ang), arcCentre - LAMP_OAL / 2 - 0.8, 0.55 * Math.cos(ang));
          g.add(pin);
        }
        [0.3, 0.7].forEach((f) => {
          const pl = new THREE.PointLight(0x8f9bff, 1.1, R * 6, 2);
          pl.position.set(0, arcBottom + LAMP_ARC * f, 0);
          g.add(pl);
        });

        // quartz window
        const wW = Math.min(11, Math.max(5, R * 0.9));
        const wH = Math.min(14, Math.max(6, H * 0.35));
        const win = new THREE.Group();
        win.add(new THREE.Mesh(new THREE.BoxGeometry(wW + 3, wH + 3, 0.9), steelDark));
        win.add(new THREE.Mesh(new THREE.BoxGeometry(wW, wH, 1.3), glass));
        win.position.set(0, H * 0.45, -R);
        g.add(win);

        const makeValve = (angDeg, y) => {
          const v = new THREE.Group();
          const pipe = new THREE.Mesh(new THREE.CylinderGeometry(1.0, 1.0, 5, 20), steelDark);
          pipe.rotation.x = PI / 2; pipe.position.z = 2.2;
          const body = new THREE.Mesh(new THREE.BoxGeometry(2.8, 2.8, 3.0), yellow);
          body.position.z = 5.4;
          const lever = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.7, 5.4), yellow);
          lever.position.set(0, 2.4, 5.4); lever.rotation.x = -0.25;
          const barb = new THREE.Mesh(new THREE.CylinderGeometry(0.75, 0.95, 3.4, 16), steelDark);
          barb.rotation.x = PI / 2; barb.position.z = 8.2;
          v.add(pipe, body, lever, barb);
          const ang = (angDeg * PI) / 180;
          v.position.set((R - 0.5) * Math.sin(ang), y, (R - 0.5) * Math.cos(ang));
          v.rotation.y = ang;
          return v;
        };
        g.add(makeValve(235, H - 3.5), makeValve(110, H * 0.62), makeValve(110, H * 0.2));

        // overhead mixer
        const mx = -R * 0.45;
        const mixer = new THREE.Group();
        const plate = new THREE.Mesh(new THREE.CylinderGeometry(4.2, 4.2, 0.6, 24), steel);
        plate.position.set(mx, H + 9.5, 0); mixer.add(plate);
        for (let i = 0; i < 3; i++) {
          const ang = (i / 3) * PI * 2 + 0.4;
          const leg = new THREE.Mesh(new THREE.BoxGeometry(0.5, 9.4, 1.4), steelDark);
          leg.position.set(mx + 3.6 * Math.sin(ang), H + 5.0, 3.6 * Math.cos(ang));
          leg.rotation.y = ang; mixer.add(leg);
        }
        const motor = new THREE.Mesh(new THREE.CylinderGeometry(3.4, 3.4, 9, 32), steel);
        motor.position.set(mx, H + 14.4, 0);
        const cap = new THREE.Mesh(new THREE.CylinderGeometry(3.6, 3.6, 4, 32), motorGreen);
        cap.position.set(mx, H + 20.6, 0);
        const capTop = new THREE.Mesh(new THREE.SphereGeometry(3.6, 32, 16, 0, PI * 2, 0, PI / 2), motorGreen);
        capTop.position.set(mx, H + 22.6, 0);
        mixer.add(motor, cap, capTop);
        const impY = H * 0.34;
        const shaft = new THREE.Mesh(new THREE.CylinderGeometry(0.45, 0.45, H + 9.5 - impY, 16), steelDark);
        shaft.position.set(mx, impY + (H + 9.5 - impY) / 2, 0);
        const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.9, 0.9, 1.6, 16), steelDark);
        hub.position.set(mx, impY, 0);
        mixer.add(shaft, hub);
        const bladeLen = Math.max(2.6, R * 0.32);
        for (let i = 0; i < 4; i++) {
          const ang = (i / 4) * PI * 2;
          const blade = new THREE.Mesh(new THREE.BoxGeometry(bladeLen, 0.25, bladeLen * 0.55), steel);
          blade.position.set(mx + (bladeLen / 2 + 0.6) * Math.cos(ang), impY, (bladeLen / 2 + 0.6) * Math.sin(ang));
          blade.rotation.y = -ang; blade.rotation.z = 0.6;
          mixer.add(blade);
        }
        g.add(mixer);

        root.add(g);

        const m = fitMetrics(g);
        const target = new THREE.Vector3(0, m.centreY, 0);
        let az = 0.32;
        const polar = 1.16;

        return {
          renderer, scene, camera,
          step(dt) {
            az += dt * 0.28;
            const dist = fitDistance(camera, m, 1.04);
            const sp = Math.sin(polar);
            camera.position.set(
              target.x + dist * sp * Math.sin(az),
              target.y + dist * Math.cos(polar),
              target.z + dist * sp * Math.cos(az)
            );
            camera.lookAt(target);
          },
        };
      }

      /* ----------------------------------------------- response surface */

      function buildSurface(canvas) {
        const { renderer, scene, camera } = mount(canvas, 34, 0.1, 400);
        scene.add(new THREE.HemisphereLight(0x9fc4dd, 0x0b1016, 0.8));
        const key = new THREE.DirectionalLight(0xffffff, 1.05);
        key.position.set(50, 80, 60); scene.add(key);
        const rimL = new THREE.DirectionalLight(0x8fa8ff, 0.5);
        rimL.position.set(-60, 30, -50); scene.add(rimL);

        const root = new THREE.Group();
        scene.add(root);

        const N = 56;
        const SPAN = 40;
        const HGT = 24;
        const logSmin = 4, logSmax = 6;      // scavenging capacity, s^-1
        const Dmin = 0, Dmax = 50;           // H2O2 dose, mg/L
        const A254 = 0.1;                    // held fixed

        // Not a named compound: a typical micropollutant that is removed
        // by the radical and does not photolyse appreciably at 254 nm.
        const representative = { kOH: 5.0e9, eps: 0, phi: 0 };

        const zAt = (u, v) => {
          const S = Math.pow(10, logSmin + u * (logSmax - logSmin));
          const dose = Dmin + v * (Dmax - Dmin);
          return model({
            doseMgL: dose, absorbance: A254,
            scavenging: S, compound: representative,
          }).survival(500);
        };

        const geo = new THREE.PlaneGeometry(SPAN, SPAN, N - 1, N - 1);
        const pos = geo.attributes.position;
        const colors = new Float32Array(pos.count * 3);
        const cLow = new THREE.Color(0x7c6bff);
        const cHigh = new THREE.Color(0xbfe9ff);

        for (let i = 0; i < pos.count; i++) {
          const u = pos.getX(i) / SPAN + 0.5;
          const v = pos.getY(i) / SPAN + 0.5;
          const z = zAt(u, v);
          pos.setZ(i, z * HGT);
          const c = cLow.clone().lerp(cHigh, z);
          colors[3 * i] = c.r;
          colors[3 * i + 1] = c.g;
          colors[3 * i + 2] = c.b;
        }
        geo.setAttribute("color", new THREE.BufferAttribute(colors, 3));
        geo.computeVertexNormals();

        const surf = new THREE.Mesh(
          geo,
          new THREE.MeshStandardMaterial({
            vertexColors: true, roughness: 0.55, metalness: 0.05,
            side: THREE.DoubleSide,
          })
        );
        surf.rotation.x = -PI / 2;
        root.add(surf);

        const wire = new THREE.Mesh(
          geo.clone(),
          new THREE.MeshBasicMaterial({
            color: 0x24303f, wireframe: true, transparent: true, opacity: 0.20,
          })
        );
        wire.rotation.x = -PI / 2;
        wire.position.y = 0.12;
        root.add(wire);

        const gridH = new THREE.GridHelper(SPAN, 8, 0xb9c6d4, 0xdbe2ec);
        gridH.material.transparent = true;
        gridH.material.opacity = 0.9;
        gridH.position.y = -0.4;
        root.add(gridH);

        // Axis frame. The two ground axes are drawn on the edges nearest
        // the camera and the vertical one on the far corner, so nothing is
        // ever read through the surface. Rebuilt each frame as it turns.
        const UP = new THREE.Vector3(0, 1, 0);
        // depthTest off so the frame is never swallowed by the surface, and a
// fixed corner so it never jumps between edges as the plot turns.
        const axMat = new THREE.MeshBasicMaterial({
          color: 0x7b8399, depthTest: false, depthWrite: false,
        });
        const ROD_R = 0.34;

        function makeRod() {
          const mesh = new THREE.Mesh(
            new THREE.CylinderGeometry(ROD_R, ROD_R, 1, 12), axMat
          );
          mesh.renderOrder = 30;
          root.add(mesh);
          return mesh;
        }
        function placeRod(mesh, a, b) {
          const va = new THREE.Vector3(a[0], a[1], a[2]);
          const vb = new THREE.Vector3(b[0], b[1], b[2]);
          const dir = new THREE.Vector3().subVectors(vb, va);
          const len = dir.length();
          mesh.position.copy(va).addScaledVector(dir, 0.5);
          mesh.quaternion.setFromUnitVectors(UP, dir.clone().normalize());
          mesh.scale.set(1, len, 1);
        }

        const h = SPAN / 2;
        const Y0 = -0.4;
        const rods = { s: makeRod(), d: makeRod(), c: makeRod() };

        // Arrowheads, so each axis reads as a direction of increase
        // rather than just a bounding line.
        const TIP_LEN = ROD_R * 8;
        function makeTip() {
          const mesh = new THREE.Mesh(
            new THREE.ConeGeometry(ROD_R * 2.8, TIP_LEN, 16), axMat
          );
          mesh.renderOrder = 30;
          root.add(mesh);
          return mesh;
        }
        function placeTip(mesh, at, dir) {
          const d = dir.clone().normalize();
          mesh.position.set(at[0], at[1], at[2]).addScaledVector(d, TIP_LEN / 2);
          mesh.quaternion.setFromUnitVectors(UP, d);
        }
        const tips = { s: makeTip(), d: makeTip(), c: makeTip() };

        // The full box, all twelve edges. Depth testing is left ON here so
        // the far edges sit behind the surface and the cube reads as a
        // volume; the three labelled axes above keep depthTest off so they
        // stay readable whatever the surface is doing.
        const boxEdges = new THREE.LineSegments(
          new THREE.EdgesGeometry(
            new THREE.BoxGeometry(SPAN, HGT - Y0, SPAN)
          ),
          new THREE.LineBasicMaterial({
            color: 0x17357a, transparent: true, opacity: 0.3,
          })
        );
        boxEdges.position.set(0, (Y0 + HGT) / 2, 0);
        root.add(boxEdges);
        const DIR_S = new THREE.Vector3(1, 0, 0);   // scavenging increases +X
        const DIR_D = new THREE.Vector3(0, 0, -1);  // dose increases -Z
        const DIR_C = new THREE.Vector3(0, 1, 0);   // C/C0 increases +Y

        function makeLabel(txt, flat) {
          const { holder, plate } = textPlate(txt, "#10265c", 26, 3.6);
          // A flat label lies in the ground plane; the vertical one stands up.
          if (flat) plate.rotation.x = -PI / 2;
          root.add(holder);
          return { holder, plate, flat };
        }
        const labels = {
          s: makeLabel("\u00B7OH scavenging capacity", true),
          d: makeLabel("H\u2082O\u2082 dose", true),
          c: makeLabel("C / C\u2080", false),
        };

        /**
         * Point a flat label along `dir` and flip it if, from where the
         * camera currently is, the text would run right-to-left. Screen-space
         * projection rather than case analysis on the octant, so it is
         * correct at every angle by construction.
         */
        const tmpA = new THREE.Vector3();
        const tmpB = new THREE.Vector3();
        function aimFlat(label, yaw, dir) {
          label.holder.rotation.y = yaw;
          tmpA.copy(label.holder.position).project(camera);
          tmpB.copy(label.holder.position).add(dir).project(camera);
          label.plate.rotation.z = tmpB.x - tmpA.x < 0 ? PI : 0;
        }

        // Fixed corner: front-left-bottom in world terms. The frame stays
        // put and the plot turns inside it, which is steadier to look at
        // than axes that hop to whichever edge faces the camera.
        const CX = -1;   // x edge the vertical axis and dose axis sit on
        const CZ = 1;    // z edge the scavenging axis sits on

        placeRod(rods.s, [-h, Y0, CZ * h], [h + 1, Y0, CZ * h]);
        placeTip(tips.s, [h + 1, Y0, CZ * h], DIR_S);

        placeRod(rods.d, [CX * h, Y0, h], [CX * h, Y0, -h - 1]);
        placeTip(tips.d, [CX * h, Y0, -h - 1], DIR_D);

        placeRod(rods.c, [CX * h, Y0, CZ * h], [CX * h, HGT + 1, CZ * h]);
        placeTip(tips.c, [CX * h, HGT + 1, CZ * h], DIR_C);

        labels.s.holder.position.set(0, Y0 + 0.05, CZ * (h + 4.2));
        labels.d.holder.position.set(CX * (h + 4.2), Y0 + 0.05, 0);
        labels.c.holder.position.set(CX * (h + 3.0), HGT * 0.5, CZ * (h + 0.4));

        function layoutAxes() {
          // Only the text needs updating: keep it the right way round for
          // wherever the camera has got to.
          aimFlat(labels.s, 0, DIR_S);
          aimFlat(labels.d, -PI / 2, DIR_D);
          labels.c.holder.rotation.y = Math.atan2(
            camera.position.x, camera.position.z
          );
          labels.c.plate.rotation.z = PI / 2;
        }

        layoutAxes();

        const m = fitMetrics(root);
        const target = new THREE.Vector3(0, m.centreY, 0);
        let az = 0.9;
        const polar = 1.06;

        return {
          renderer, scene, camera,
          step(dt) {
            az += dt * 0.2;
            const dist = fitDistance(camera, m, 1.06);
            const sp = Math.sin(polar);
            camera.position.set(
              target.x + dist * sp * Math.sin(az),
              target.y + dist * Math.cos(polar),
              target.z + dist * sp * Math.cos(az)
            );
            camera.lookAt(target);
            layoutAxes();
          },
        };
      }

      /* -------------------------------------------------------- run it */

      let scenes;
      try {
        scenes = [
          buildReactor(rig.querySelector("[data-reactor]")),
          buildSurface(rig.querySelector("[data-surface]")),
        ];
      } catch (err) {
        console.error(err);
        return fail();
      }

      const clock = new THREE.Clock();
      let raf = null;

      function draw(dt) {
        scenes.forEach((s) => {
          s.step(dt);
          s.renderer.render(s.scene, s.camera);
        });
      }

      function loop() {
        raf = requestAnimationFrame(loop);
        draw(clock.getDelta());
      }

      clock.getDelta();
      if (reduced) {
        draw(0); // one static frame, correctly framed
      } else {
        loop();
      }

      new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (reduced) return;
          if (e.isIntersecting && raf === null) {
            clock.getDelta();
            loop();
          } else if (!e.isIntersecting && raf !== null) {
            cancelAnimationFrame(raf);
            raf = null;
          }
        });
      }).observe(rig);
    }

    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) {
        obs.disconnect();
        boot();
      }
    }, { rootMargin: "250px" }).observe(rig);
  }
</script>

