---
const { pub } = Astro.props;
const isPatent = pub.type === "patent";

function fmt(author) {
  return author;
}
---

<li class="pub">
  <p class="pub__authors">
    {pub.authors.map((a, i) => (
      <>
        <span class={a.startsWith("Wang, C") ? "pub__self" : ""}>{fmt(a)}</span
        >{i < pub.authors.length - 1 ? "; " : ""}
      </>
    ))}
  </p>
  <h3 class="pub__title">
    {pub.title}
  </h3>
  <p class="pub__meta data">
    {isPatent ? <span class="pub__kind">Patent</span> : <em>{pub.journal}</em>}
    {
      isPatent ? (
        <> {pub.number}</>
      ) : (
        <>
          {pub.volume ? <> {pub.volume}</> : null}{pub.number ? <> ({pub.number})</> : null}{pub.pages ? <>, {pub.pages}</> : null}
        </>
      )
    }
    <span class="pub__year"> · {pub.year}</span>
    {pub.language === "chinese" ? <span class="pub__tag">in Chinese</span> : null}
    {isPatent && pub.note ? <span class="pub__tag">{pub.note}</span> : null}
  </p>
  {pub.note && !isPatent ? <p class="pub__note">{pub.note}</p> : null}
</li>

<style>
  .pub {
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .pub:first-child {
    border-top: 0;
  }
  .pub__authors {
    font-family: var(--data);
    font-size: 0.78rem;
    color: var(--ink-45);
    line-height: 1.6;
    margin: 0 0 0.45rem;
    max-width: none;
  }
  .pub__self {
    color: var(--ink);
    font-weight: 500;
  }
  .pub__title {
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.45rem;
    max-width: 58ch;
  }
  .pub__title a {
    text-decoration-color: var(--mb-300);
  }
  .pub__meta {
    font-size: 0.8rem;
    color: var(--ink-70);
    margin: 0;
    max-width: none;
  }
  .pub__kind {
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--mb-700);
  }
  .pub__year {
    color: var(--ink-45);
  }
  .pub__tag {
    display: inline-block;
    margin-left: 0.6rem;
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-45);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.1rem 0.4rem;
  }
  .pub__note {
    font-size: 0.86rem;
    color: var(--ink-70);
    margin: 0.5rem 0 0;
    font-style: italic;
  }
</style>
